{
  "name": "deathless-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "npx vite build",
    "build:server": "npx tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:append-travelogue": "tsx scripts/append-travelogue-session.ts",
    "db:append-stress": "tsx scripts/append-travelogue-session.ts --stress",
    "db:remove-stress": "tsx scripts/append-travelogue-session.ts --delete-stress",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:local": "tsx scripts/local-db.ts"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.2",
    "@types/node": "^22.15.21",
    "@types/pg": "^8.15.2",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.44.2",
    "express": "^5.1.0",
    "fractional-indexing": "^3.2.0",
    "pg": "^8.16.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "drizzle-kit": "^0.31.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "tsx": "^4.19.4"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "@embedded-postgres/windows-x64@18.4.0-beta.17": true
  }
}
