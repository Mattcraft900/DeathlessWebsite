# Local embedded Postgres (npm run db:local):
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/postgres
#
# Local Docker (docker compose up -d):
# DATABASE_URL=postgresql://deathless:deathless@localhost:5432/deathless
#
# Or paste your Neon connection string:
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Random secret for signed session cookies (generate a long random string)
SESSION_SECRET=change-me-to-a-long-random-string

# Server port
PORT=3000

# Default PIN used when seeding writers (change after first login)
SEED_DEFAULT_PIN=deathless
